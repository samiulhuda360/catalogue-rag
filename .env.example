# Catalogue RAG - copy to .env and fill in. Never commit .env (it is in .gitignore).

# Language model: any OpenAI-compatible endpoint. OpenRouter by default (https://openrouter.ai).
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=qwen/qwen3-235b-a22b-2507

# PDF extraction with LlamaParse (https://cloud.llamaindex.ai). Only needed to add PDF catalogues;
# Markdown and text files work without it.
LLAMA_CLOUD_API_KEY=

# Adding catalogues from the web UI / API. Leave empty to keep uploads switched off (e.g. on a public
# demo). Use a long random value: python -c "import secrets; print(secrets.token_urlsafe(24))"
CATALOGUE_ADMIN_TOKEN=
# CATALOGUE_MAX_UPLOAD_MB=50

# Optional overrides
# CATALOGUE_PARSED_DIR=data/parsed_documents   (default: that folder, or the bundled sample when it is empty)
# CATALOGUE_INDEX_DIR=index
# CATALOGUE_BRANDS=brand1,brand2                (recognised in file names, stored as metadata)
